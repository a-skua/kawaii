{
  "name": "@askua/kawaii",
  "version": "1.0.0-1",
  "exports": {
    ".": "./mod.ts",
    "./wasip1": "./wasip1.ts"
  },
  "tasks": {
    "docs": "deno doc --output=docs --html mod.ts wasip1.ts wasip1/mod.ts",
    "examples/hello": "deno run --no-prompt --allow-read=./examples/hello ./examples/hello/main.ts",
    "examples/read": "deno run --no-prompt --allow-read=./examples/read ./examples/read/main.ts",
    "test": "deno test --coverage=coverage; deno coverage --lcov --output=coverage.lcov coverage; genhtml -o coverage/html coverage.lcov",
    "coverage": "deno task test; python3 -m http.server -d coverage/html"
  },
  "fmt": {
    "exclude": ["coverage/", "web/", "docs/"]
  },
  "imports": {
    "@askua/core": "jsr:@askua/core@^1.1.2",
    "@std/assert": "jsr:@std/assert@^1.0.11"
  }
}
